package com.example.costumerentalsystem.controller;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.Objects;
import java.util.UUID;

import org.springframework.http.HttpStatus;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.multipart.MultipartFile;
import org.springframework.web.server.ResponseStatusException;

import com.example.costumerentalsystem.domain.entity.User;
import com.example.costumerentalsystem.domain.enums.PaymentMethod;
import com.example.costumerentalsystem.domain.enums.Role;
import com.example.costumerentalsystem.domain.enums.RentalStatus;
import com.example.costumerentalsystem.dto.request.PaymentRequest;
import com.example.costumerentalsystem.dto.response.RentalResponse;
import com.example.costumerentalsystem.service.RentalLifecycleService;
import com.example.costumerentalsystem.service.RentalService;

import jakarta.servlet.http.HttpSession;

@Controller
@RequestMapping("/payments")
public class PaymentController {

    private static final long MAX_SLIP_SIZE = 10 * 1024 * 1024;

    private final RentalService rentalService;
    private final RentalLifecycleService rentalLifecycleService;

    public PaymentController(
            RentalService rentalService,
            RentalLifecycleService rentalLifecycleService) {
        this.rentalService = rentalService;
        this.rentalLifecycleService = rentalLifecycleService;
    }

    @GetMapping("/pay/{rentalId}")
    public String showPaymentPage(
            @PathVariable Long rentalId,
            Model model,
            HttpSession session) {

        User user = getLoggedInUser(session);
        if (user == null) {
            return "redirect:/login";
        }

        RentalResponse rental = rentalService.getById(rentalId);
        checkAccess(user, rental);

        if (rental.status() != RentalStatus.PENDING_PAYMENT) {
            return "redirect:/orders";
        }

        model.addAttribute("rental", rental);
        return "user/payment";
    }

    @PostMapping("/submit")
    public String submitPayment(
            @RequestParam Long rentalId,
            @RequestParam PaymentMethod paymentMethod,
            @RequestParam(value = "slipFile", required = false)
            MultipartFile slipFile,
            HttpSession session) {

        User user = getLoggedInUser(session);
        if (user == null) {
            return "redirect:/login";
        }

        RentalResponse rental = rentalService.getById(rentalId);
        checkAccess(user, rental);

        if (rental.status() != RentalStatus.PENDING_PAYMENT) {
            return "redirect:/orders";
        }

        String slipUrl = storeSlip(slipFile);

        PaymentRequest request = new PaymentRequest(paymentMethod, slipUrl);
        rentalLifecycleService.pay(rentalId, request);

        return "user/payment-success";
    }

    private User getLoggedInUser(HttpSession session) {
        Object value = session.getAttribute("loggedInUser");
        return value instanceof User user ? user : null;
    }

    private void checkAccess(User user, RentalResponse rental) {
        boolean isAdmin = user.getRole() == Role.ADMIN;
        boolean isOwner = Objects.equals(user.getId(), rental.userId());

        if (!isAdmin && !isOwner) {
            throw new ResponseStatusException(
                    HttpStatus.FORBIDDEN,
                    "ไม่มีสิทธิ์เข้าถึงรายการเช่านี้");
        }
    }

    private String storeSlip(MultipartFile file) {
        if (file == null || file.isEmpty()) {
            return null;
        }

        if (file.getSize() > MAX_SLIP_SIZE) {
            throw new ResponseStatusException(
                    HttpStatus.BAD_REQUEST,
                    "ไฟล์สลิปต้องมีขนาดไม่เกิน 10 MB");
        }

        String extension;
        String contentType = file.getContentType();

        if ("image/jpeg".equalsIgnoreCase(contentType)) {
            extension = ".jpg";
        } else if ("image/png".equalsIgnoreCase(contentType)) {
            extension = ".png";
        } else if ("image/webp".equalsIgnoreCase(contentType)) {
            extension = ".webp";
        } else {
            throw new ResponseStatusException(
                    HttpStatus.BAD_REQUEST,
                    "รองรับเฉพาะไฟล์ภาพ JPEG, PNG และ WebP");
        }

        String fileName = UUID.randomUUID() + extension;
        Path uploadDir = Paths.get("src/main/resources/static/uploads");

        try {
            Files.createDirectories(uploadDir);
            Files.copy(file.getInputStream(), uploadDir.resolve(fileName));
            return "/uploads/" + fileName;
        } catch (IOException e) {
            throw new ResponseStatusException(
                    HttpStatus.INTERNAL_SERVER_ERROR,
                    "ไม่สามารถบันทึกไฟล์สลิปได้",
                    e);
        }
    }
}
